{
  "name": "modit",
  "version": "0.1.0",
  "description": "MODit - mod manager",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && node scripts/copy-static.js",
    "start": "npm run build && electron .",
    "dev": "node scripts/dev.js",
    "watch": "tsc --watch",
    "test": "npm run build && node --test \"test/*.test.js\"",
    "dist": "npm run build && electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "adm-zip": "^0.5.16",
    "better-sqlite3": "^13.2.0",
    "node-7z": "^3.0.0",
    "node-unrar-js": "^2.0.2"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.0.0",
    "@types/node-7z": "^2.1.10",
    "electron": "45.4.1",
    "electron-builder": "^26.18.0",
    "node-gyp": "^13.1.0",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "node-gyp": "$node-gyp"
  },
  "build": {
    "appId": "app.modit",
    "productName": "MODit",
    "files": [
      "dist/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/7zip-bin/**",
      "node_modules/better-sqlite3/**"
    ]
  }
}
