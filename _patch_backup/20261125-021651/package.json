{
  "name": "modit",
  "version": "0.1.0",
  "description": "MODit - mod manager",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && node scripts/copy-static.js",
    "start": "npm run build && electron .",
    "dev": "tsc --watch",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "adm-zip": "^0.5.16",
    "node-7z": "^3.0.0",
    "node-unrar-js": "^2.0.2"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/node": "^22.0.0",
    "@types/node-7z": "^2.1.10",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.0"
  },
  "build": {
    "appId": "app.modit",
    "productName": "MODit",
    "files": ["dist/**", "package.json"],
    "asarUnpack": ["node_modules/7zip-bin/**"]
  }
}
